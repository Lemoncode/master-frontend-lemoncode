{
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "rootDir": "src",
    "outDir": "transpiled"
  },
  "compileOnSave": true,
  "exclude": ["node_modules"],
  "include": ["src"]
}
